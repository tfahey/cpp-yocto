# Dockerfile for Yocto Qt5 Build Environment (x86-64 with Veracode CLI)
#
# Usage:
#   docker build --platform linux/amd64 -t yocto-qt-builder:x86-64 -f Dockerfile.x86-64 .
#   docker run -it -v $(pwd):/home/yocto/project yocto-qt-builder:x86-64
#
# Based on: Ubuntu 20.04 LTS
# Includes: Veracode CLI for SAST packaging (x86-64 only)
#
# Architecture note: This is a separate image from the base Dockerfile because
# Veracode CLI is only available for x86-64 architecture. Use this image for:
#   - x86-64 builds with veracode package/upload support
#   - Manual testing via CONTAINER_MANAGER.sh with x86-64 architecture
# For ARM64 builds, use the base Dockerfile (yocto-qt-builder:arm64)

FROM ubuntu:20.04

# Metadata
LABEL maintainer="Yocto Learning Project"
LABEL description="Complete Yocto build environment with Qt5 support and Veracode CLI (x86-64 only)"

# Prevent interactive prompts during installation
ENV DEBIAN_FRONTEND=noninteractive

# Set locale for Yocto (required for bitbake)
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8
ENV LANGUAGE=en_US.UTF-8

# Install all Yocto build dependencies in one layer (reduces image size)
# Note: Using --allow-insecure-repositories to work around expired Ubuntu 20.04 GPG keys
RUN apt-get update --allow-insecure-repositories --allow-unauthenticated 2>&1 | grep -v "GPG error" || true && \
    apt-get install -y --allow-unauthenticated \
    # Version control
    git \
    \
    # Yocto core tools
    chrpath \
    diffstat \
    wget \
    \
    # Python (required for BitBake)
    python3 \
    python3-dev \
    python3-pip \
    \
    # Build tools
    texinfo \
    gcc \
    g++ \
    build-essential \
    cmake \
    \
    # System tools
    curl \
    sudo \
    \
    # Development libraries
    libncurses-dev \
    zlib1g-dev \
    gawk \
    libbz2-dev \
    libssl-dev \
    socat \
    cpio \
    time \
    bison \
    flex \
    xz-utils \
    liblz4-tool \
    zstd \
    \
    # Optional but useful
    vim \
    nano \
    less \
    ipython3 \
    locales \
    \
    # Cleanup
    && rm -rf /var/lib/apt/lists/*

# Generate UTF-8 locale (required for Yocto/BitBake)
RUN locale-gen en_US.UTF-8 && \
    update-locale LANG=en_US.UTF-8

# Install Veracode CLI for SAST packaging (x86-64 only)
RUN curl -fsS https://tools.veracode.com/veracode-cli/install | VERACODE_CLI_VERSION=2.53.0 sh

# Create non-root user for builds (Yocto best practice)
# This prevents permission issues and is more secure
RUN useradd -m -s /bin/bash yocto && \
    echo "yocto ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers && \
    mkdir -p /home/yocto/project && \
    chown -R yocto:yocto /home/yocto

# Switch to non-root user
USER yocto

# Set working directory
WORKDIR /home/yocto/project

# Set helpful shell prompt
ENV PS1="\[$(tput bold)\]\[$(tput setaf 2)\]yocto-container:\w\$\[$(tput sgr0)\] "

# Print build info
RUN echo "Yocto Qt5 Build Environment Ready (x86-64 with Veracode)" && \
    echo "Yocto User: $(whoami)" && \
    echo "Python: $(python3 --version)" && \
    echo "Git: $(git --version)" && \
    echo "GCC: $(gcc --version | head -1)" && \
    echo "Veracode: $(sudo veracode --version 2>/dev/null || echo 'installed')"

# Default command (interactive bash shell)
CMD ["/bin/bash"]
